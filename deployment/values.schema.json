{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["destination", "deployment"],
      "properties": {
        "destination": {
          "type": "string",
          "enum": ["aws", "gcp", "hcp", "datacenter", "azure"],
          "description": "Target platform. Selects the Service/Ingress flavour and the platform-specific objects (SecurityGroupPolicy on aws, SecretProviderClass on gcp)."
        },
        "deployment": {
          "type": "object",
          "required": ["image"],
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "uri": { "type": "string" },
                "pullPolicy": { "type": "string" }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer", "None"]
            },
            "ports": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["inner", "outer"],
                "properties": {
                  "inner": { "type": "integer" },
                  "outer": { "type": "integer" }
                }
              }
            }
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["enabled"],
            "properties": {
              "enabled": { "type": "boolean" },
              "hosts": { "type": "array" },
              "lbOrder": { "type": "integer" },
              "idleTimeout": { "type": "integer" },
              "className": { "type": ["string", "null"] },
              "wafId": { "type": ["string", "null"] },
              "listenPorts": { "type": "string", "enum": ["http", "https", "both"] },
              "sslRedirect": { "type": "boolean" },
              "healthcheckPath": { "type": "string" },
              "rolloutService": { "type": "string", "enum": ["", "preview", "active"] },
              "name": { "type": "string" },
              "servicePortName": { "type": "string" },
              "albId": { "type": ["string", "null"] },
              "albName": { "type": ["string", "null"] },
              "albNamespace": { "type": ["string", "null"] },
              "albFrontend": { "type": ["string", "null"] }
            }
          }
        },
        "cronjobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "enabled", "schedule"],
            "properties": {
              "name": { "type": "string" },
              "enabled": { "type": "boolean" },
              "schedule": { "type": "string" },
              "command": { "type": "array", "items": { "type": "string" } },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "pdb": {
          "type": "object",
          "description": "PodDisruptionBudget. Off by default. When enabled, set exactly one of minAvailable / maxUnavailable (integer or percentage string).",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^(100|[1-9]?[0-9])%$" },
                { "type": "null" }
              ]
            },
            "maxUnavailable": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "pattern": "^(100|[1-9]?[0-9])%$" },
                { "type": "null" }
              ]
            },
            "unhealthyPodEvictionPolicy": {
              "enum": ["IfHealthyBudget", "AlwaysAllow", null]
            }
          }
        },
        "posthooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "enabled"],
            "properties": {
              "name": { "type": "string" },
              "enabled": { "type": "boolean" },
              "command": { "type": "array", "items": { "type": "string" } },
              "args": { "type": "array", "items": { "type": "string" } },
              "weight": { "type": "string" },
              "backoffLimit": { "type": "integer" },
              "resources": { "type": "object" }
            }
          }
        },
        "pvc": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    }
  }
}
