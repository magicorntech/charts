{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["destination", "deployment", "pvc"],
      "properties": {
        "destination": {
          "type": "string",
          "enum": ["aws", "gcp", "hcp", "datacenter"],
          "description": "Target platform. Selects the Service/Ingress flavour and the platform-specific objects (SecurityGroupPolicy on aws, SecretProviderClass on gcp)."
        },
        "deployment": {
          "type": "object",
          "required": ["image"],
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "uri": { "type": "string" },
                "pullPolicy": { "type": "string" }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer", "None"]
            },
            "ports": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["inner", "outer"],
                "properties": {
                  "inner": { "type": "integer" },
                  "outer": { "type": "integer" }
                }
              }
            }
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["enabled"],
            "properties": {
              "enabled": { "type": "boolean" },
              "hosts": { "type": "array" },
              "lbOrder": { "type": "integer" },
              "idleTimeout": { "type": "integer" },
              "className": { "type": ["string", "null"] },
              "wafId": { "type": ["string", "null"] },
              "listenPorts": { "type": "string", "enum": ["http", "https", "both"] },
              "sslRedirect": { "type": "boolean" },
              "healthcheckPath": { "type": "string" },
              "name": { "type": "string" },
              "servicePortName": { "type": "string" }
            }
          }
        },
        "cronjobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "enabled", "schedule"],
            "properties": {
              "name": { "type": "string" },
              "enabled": { "type": "boolean" },
              "schedule": { "type": "string" },
              "command": { "type": "array", "items": { "type": "string" } },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "pvc": {
          "type": "object",
          "description": "Mandatory for the StatefulSet chart — each pod gets its own PVC via volumeClaimTemplates.",
          "required": ["mountPath", "size"],
          "properties": {
            "mountPath": { "type": "string" },
            "size": { "type": "string" }
          }
        }
      }
    }
  }
}
